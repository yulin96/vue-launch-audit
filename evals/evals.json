{
  "schema_version": 2,
  "skill_name": "vue-launch-audit",
  "evals": [
    {
      "id": "full-audit-deploy-safety",
      "prompt": "使用 $vue-launch-audit 检查这个 Vue 项目上线风险，先不要改代码，也不要 build。",
      "mode": "full_audit",
      "fixture": "fixtures/deploy-side-effect",
      "assertions": [
        "confirms_vue_before_audit",
        "inspects_package_scripts_and_vite_plugins_first",
        "does_not_run_build_or_deploy",
        "does_not_modify_files",
        "reports_static_runtime_boundary",
        "uses_standard_full_audit_summary",
        "shows_p0_and_p1_sections_even_when_empty"
      ]
    },
    {
      "id": "full-audit-p0-cross-user-corruption",
      "prompt": "使用 $vue-launch-audit 做完整上线审查。重点判断切换编辑对象后保存是否会写错用户；不要修改代码或运行 build。",
      "mode": "full_audit",
      "fixture": "fixtures/p0-cross-user-corruption",
      "assertions": [
        "traces_route_identity_load_and_save_path",
        "reports_cross_user_overwrite_as_p0_likely",
        "states_runtime_evidence_needed_for_confirmation",
        "recommends_block_release",
        "uses_stable_p0_identifier",
        "does_not_map_scanner_priority_to_severity",
        "does_not_modify_files"
      ]
    },
    {
      "id": "full-audit-mixed-severity-ordering",
      "prompt": "使用 $vue-launch-audit 做完整上线审查，按发布严重度输出问题；不要修改代码、运行 build 或打开浏览器。",
      "mode": "full_audit",
      "fixture": "fixtures/mixed-severity",
      "assertions": [
        "reports_checkout_lock_failure_as_p1",
        "reports_nonfunctional_help_link_below_p1",
        "orders_findings_by_severity",
        "uses_stable_finding_identifiers",
        "separates_severity_from_evidence_state",
        "recommends_fix_before_release",
        "does_not_modify_files"
      ]
    },
    {
      "id": "targeted-state-residual",
      "prompt": "切换用户后偶尔显示上一个人的姓名，用 $vue-launch-audit 只分析这个问题。",
      "mode": "targeted_diagnosis",
      "fixture": "fixtures/state-residual",
      "assertions": [
        "does_not_expand_to_full_audit",
        "traces_response_state_and_visible_ui",
        "treats_scanner_output_as_lead",
        "identifies_object_merge_as_supported_cause",
        "does_not_modify_files"
      ]
    },
    {
      "id": "copy-baseline-only",
      "prompt": "用 $vue-launch-audit 检查用户可见文案中的明确错词，不检查品牌风格。",
      "mode": "copy_audit",
      "fixture": "fixtures/copy-audit",
      "assertions": [
        "uses_baseline_term_rules_only",
        "reports_visible_baseline_typo",
        "does_not_report_unapproved_style_rules",
        "does_not_modify_files"
      ]
    },
    {
      "id": "copy-approved-style",
      "prompt": "用 $vue-launch-audit 检查文案；本项目明确采用 WeChat 拼写和单个中文标点。",
      "mode": "copy_audit",
      "fixture": "fixtures/copy-audit",
      "assertions": [
        "loads_optional_style_rules",
        "confirms_hits_are_user_visible",
        "reports_brand_case_and_repeated_punctuation"
      ]
    },
    {
      "id": "non-vue-routing",
      "prompt": "看看这个 Vite 项目发布前有没有问题，但它是 React。",
      "mode": "not_applicable",
      "fixture": "fixtures/react-negative",
      "assertions": [
        "does_not_use_vue_audit_workflow",
        "does_not_run_vue_scanners",
        "states_non_vue_boundary"
      ]
    },
    {
      "id": "sdk-lock-targeted",
      "prompt": "扫码按钮在 wx 配置失败后一直没反应，用 $vue-launch-audit 找原因。",
      "mode": "targeted_diagnosis",
      "fixture": null,
      "assertions": [
        "loads_sdk_mobile_reference",
        "checks_config_cancel_timeout_and_error_closure",
        "separates_static_evidence_from_device_runtime"
      ]
    },
    {
      "id": "runtime-gap",
      "prompt": "URL 变了但 keep-alive 页面还是旧内容，保留 transition 和 keep-alive，只做静态分析。",
      "mode": "targeted_diagnosis",
      "fixture": null,
      "assertions": [
        "checks_component_and_cache_identity",
        "preserves_user_constraint",
        "does_not_open_browser",
        "labels_unreproduced_behavior_likely_not_confirmed"
      ]
    },
    {
      "id": "scoped-implementation",
      "prompt": "已经确认是新用户数据 Object.assign 到旧对象导致残留，请用 $vue-launch-audit 做最小修复。",
      "mode": "implementation",
      "fixture": "fixtures/state-residual",
      "assertions": [
        "changes_only_confirmed_state_assignment",
        "runs_targeted_validation",
        "does_not_expand_to_full_audit_or_build"
      ]
    },
    {
      "id": "repeated-event-versus-latest-state",
      "prompt": "每条消息都应该计数。连续收到相同字符串时 Watch count 少了，Callback count 正常。用 $vue-launch-audit 只分析计数差异，不改代码，也不要运行浏览器。",
      "mode": "targeted_diagnosis",
      "fixture": "fixtures/event-lifecycle",
      "assertions": [
        "traces_publish_subscribe_ref_watch_and_both_counters",
        "distinguishes_event_delivery_from_latest_value_changes",
        "does_not_flag_latest_value_display_as_a_defect",
        "does_not_append_unrelated_audio_cleanup_findings",
        "does_not_modify_files_or_open_browser"
      ]
    },
    {
      "id": "template-ref-cleanup-versus-captured-resource",
      "prompt": "检查 Counter.vue 离开页面时两个音频对象的清理是否有效，只分析这条生命周期，不运行浏览器、不修改代码。",
      "mode": "targeted_diagnosis",
      "fixture": "fixtures/event-lifecycle",
      "assertions": [
        "distinguishes_template_ref_from_independently_captured_audio",
        "checks_template_ref_availability_in_unmounted_hook",
        "does_not_claim_all_onunmounted_cleanup_is_wrong",
        "does_not_infer_real_audio_playback_from_source",
        "does_not_append_unrelated_counter_findings"
      ]
    },
    {
      "id": "navigation-cancel-history",
      "prompt": "导航守卫取消跳转后历史栈多了一项。用 $vue-launch-audit 对比 history.ts 的两个方法，只分析，不改代码、不运行 build 或浏览器。",
      "mode": "targeted_diagnosis",
      "fixture": "fixtures/navigation-history",
      "assertions": [
        "identifies_history_mutation_before_navigation_success",
        "distinguishes_resolved_navigation_failure_from_thrown_error",
        "recognizes_failure_check_in_replace_safely",
        "does_not_claim_device_back_gestures_are_verified",
        "does_not_replace_existing_history_semantics"
      ]
    },
    {
      "id": "export-centering-evidence-gap",
      "prompt": "页面昵称是居中的，但用户反馈导出的 PNG 昵称偏下。用 $vue-launch-audit 只做静态诊断，不改代码，也不执行浏览器、build 或图片导出。",
      "mode": "targeted_diagnosis",
      "fixture": "fixtures/poster-export",
      "assertions": [
        "traces_dom_capture_canvas_and_encoding",
        "does_not_treat_css_centering_as_export_proof",
        "recognizes_existing_font_readiness_wait",
        "does_not_claim_font_baseline_or_security_error_as_confirmed_cause",
        "specifies_exported_short_long_and_mixed_script_samples_as_unrun_validation",
        "does_not_request_repeated_exceptions_to_static_only_scope"
      ]
    },
    {
      "id": "implementation-named-copy-control",
      "prompt": "用 $vue-launch-audit 做一个定向修复：给“复制手机统计地址”按钮加一个能看出是复制的内联 SVG 图标。保留文字和 disabled/click 行为，不调整时间范围控件，不运行 build 或浏览器。",
      "mode": "implementation",
      "fixture": "fixtures/control-scope",
      "assertions": [
        "adds_copy_icon_to_named_button",
        "preserves_visible_label_disabled_and_click_behavior",
        "leaves_time_range_control_unchanged",
        "checks_final_diff_against_named_request",
        "reports_visual_verification_as_unperformed"
      ]
    }
  ]
}
